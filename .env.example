# ============================================================
# TELEGRAM AFFILIATE BOT — Environment Configuration
# ============================================================
# Copy this file to .env and fill in all values before running
# ============================================================

# ── SERVER ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | staging

# ── TELEGRAM ─────────────────────────────────────────────────
TELEGRAM_API_ID=              # Numeric API ID from my.telegram.org
TELEGRAM_API_HASH=            # Hex string from my.telegram.org
TELEGRAM_STRING_SESSION=      # Pre-generated StringSession (from Colab)
TELEGRAM_ALLOWED_CHATS=       # Comma-separated list of Chat IDs to monitor. Leave empty to monitor ALL chats.

# ── EARNKARO ─────────────────────────────────────────────────
EARNKARO_API_TOKEN=           # Bearer token from EarnKaro developer portal
EARNKARO_API_URL=https://ekaro-api.affiliaters.in/api/converter/public
EARNKARO_TIMEOUT_MS=10000     # API call timeout in ms
EARNKARO_MAX_RETRIES=3        # Number of retry attempts on failure

# ── WHATSAPP ─────────────────────────────────────────────────
WHATSAPP_SENDER_URL=          # Your RailOne hosted WhatsApp API base URL
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_MAX_RETRIES=3

# ── MESSAGE PROCESSING ───────────────────────────────────────
DEDUP_CACHE_TTL_SECONDS=3600  # How long to remember processed message IDs
MAX_URLS_PER_MESSAGE=10       # Safety cap on URLs extracted per message

# ── LOGGING ──────────────────────────────────────────────────
LOG_LEVEL=info                # error | warn | info | http | verbose | debug
LOG_DIR=./logs
